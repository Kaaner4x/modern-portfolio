@model AboutEditViewModel?
@{
    ViewData["Title"] = "Company Profile Management";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <!-- Header -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="bg-light rounded p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="btn-square bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="fa fa-building fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-1 text-primary fw-bold">Company Profile &amp; Overview</h4>
                        <p class="text-muted mb-0 small">Manage Aveny Technologies' corporate bio, mission statement, headquarters, and enterprise channels.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fa fa-check-circle fa-lg me-2 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fa fa-exclamation-triangle fa-lg me-2 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Content Form -->
    @if (Model is null)
    {
        @await Html.PartialAsync("_CreatePartial", new AboutCreateViewModel())
    }
    else
    {
        @await Html.PartialAsync("_EditPartial", Model)
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
