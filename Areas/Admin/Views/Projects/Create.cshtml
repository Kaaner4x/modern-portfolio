@model ProjectCreateViewModel
@{
    ViewData["Title"] = "Publish Enterprise Solution";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <!-- Header -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="bg-light rounded p-4 d-flex align-items-center justify-content-between shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="btn-square bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fa fa-plus-circle fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-1 text-primary fw-bold">Publish Enterprise Solution</h4>
                        <p class="text-muted mb-0 small">Add a new software platform, cloud service, or client case study to Aveny Technologies' showcase.</p>
                    </div>
                </div>
                <a asp-area="Admin" asp-controller="Projects" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fa fa-arrow-left me-2"></i>Back to Solutions
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fa fa-exclamation-triangle fa-lg me-2 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form Card -->
    <div class="row g-4 justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="bg-light rounded p-4 p-md-5 shadow-sm">
                <form asp-area="Admin" asp-controller="Projects" asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                    <div class="row g-3">
                        <!-- Project Title -->
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-bold">Solution / Platform Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa fa-laptop-code text-muted"></i></span>
                                <input asp-for="Title" class="form-control" placeholder="e.g. Aveny CloudMesh - Enterprise Microservices Gateway" autofocus />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Project Description -->
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold">Architectural Overview &amp; Key Features</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Explain the system architecture, business impact, scalability metrics, and core technologies used..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Live URL & GitHub URL -->
                        <div class="col-md-6">
                            <label asp-for="ProjectUrl" class="form-label fw-bold">Live Platform / Product URL</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa fa-globe text-muted"></i></span>
                                <input asp-for="ProjectUrl" class="form-control" placeholder="https://avenytechnologies.com/solutions/cloudmesh" />
                            </div>
                            <span asp-validation-for="ProjectUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GithubUrl" class="form-label fw-bold">GitHub Source / Repository URL</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fab fa-github text-muted"></i></span>
                                <input asp-for="GithubUrl" class="form-control" placeholder="https://github.com/aveny-technologies/cloudmesh" />
                            </div>
                            <span asp-validation-for="GithubUrl" class="text-danger small"></span>
                        </div>

                        <!-- Image File Upload -->
                        <div class="col-12">
                            <label asp-for="ImageFile" class="form-label fw-bold">Cover / Architecture Screenshot</label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" onchange="previewProjectCreateImage(this)" />
                            <div class="form-text">Supported formats: JPG, JPEG, PNG, WEBP, GIF (Max size: 5MB).</div>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>

                            <div id="projectCreateImagePreviewContainer" class="mt-3 d-none">
                                <p class="small text-muted mb-1 fw-bold">Image Preview:</p>
                                <img id="projectCreateImagePreview" src="#" alt="Preview" class="img-thumbnail rounded-3 shadow-sm" style="max-height: 200px;" />
                            </div>
                        </div>

                        <!-- Active Toggle -->
                        <div class="col-12 mt-3">
                            <div class="form-check form-switch fs-6">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" checked />
                                <label class="form-check-label fw-bold ms-2" for="isActiveSwitch">
                                    Publish solution immediately on public website
                                </label>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-12 mt-4 pt-3 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                                <i class="fa fa-save me-2"></i>Publish Solution
                            </button>
                            <a asp-area="Admin" asp-controller="Projects" asp-action="Index" class="btn btn-light rounded-pill px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewProjectCreateImage(input) {
            const previewContainer = document.getElementById('projectCreateImagePreviewContainer');
            const previewImg = document.getElementById('projectCreateImagePreview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewContainer.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
