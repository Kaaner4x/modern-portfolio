@model TestimonialCreateViewModel
@{
    ViewData["Title"] = "Add Client Endorsement";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .star-rating-btn {
        font-size: 1.5rem;
        cursor: pointer;
        color: #ffc107;
        transition: transform 0.15s ease;
    }
    .star-rating-btn:hover {
        transform: scale(1.2);
    }
    .star-rating-btn.unselected {
        color: #ced4da;
    }
</style>

<div class="container-fluid pt-4 px-4">
    <!-- Header -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="bg-light rounded p-4 d-flex align-items-center justify-content-between shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="btn-square bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fa fa-plus-circle fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="mb-1 text-primary fw-bold">Add Client Endorsement</h4>
                        <p class="text-muted mb-0 small">Publish a new executive review, partner testimonial, or client feedback for Aveny Technologies.</p>
                    </div>
                </div>
                <a asp-area="Admin" asp-controller="Testimonials" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fa fa-arrow-left me-2"></i>Back to Reviews
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fa fa-exclamation-triangle fa-lg me-2 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form Card -->
    <div class="row g-4 justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="bg-light rounded p-4 p-md-5 shadow-sm">
                <form asp-area="Admin" asp-controller="Testimonials" asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                    <div class="row g-3">
                        <!-- Client Name -->
                        <div class="col-md-6">
                            <label asp-for="ClientName" class="form-label fw-bold">Executive / Client Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa fa-user text-muted"></i></span>
                                <input asp-for="ClientName" class="form-control" placeholder="e.g. Sarah Jenkins" autofocus />
                            </div>
                            <span asp-validation-for="ClientName" class="text-danger small"></span>
                        </div>

                        <!-- Client Position / Company -->
                        <div class="col-md-6">
                            <label asp-for="ClientPosition" class="form-label fw-bold">Title / Enterprise Partner</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa fa-briefcase text-muted"></i></span>
                                <input asp-for="ClientPosition" class="form-control" placeholder="e.g. VP of Engineering, CloudScale Global" />
                            </div>
                            <span asp-validation-for="ClientPosition" class="text-danger small"></span>
                        </div>

                        <!-- Star Rating Picker -->
                        <div class="col-12">
                            <label asp-for="Rating" class="form-label fw-bold d-block">Satisfaction Rating (1 - 5 Stars)</label>
                            <input type="hidden" asp-for="Rating" id="ratingInput" value="@Model.Rating" />
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <div id="starPicker" class="d-inline-flex">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fa fa-star star-rating-btn @(i <= Model.Rating ? "" : "unselected")" data-value="@i" onclick="setRating(@i)"></i>
                                    }
                                </div>
                                <span class="badge bg-warning bg-opacity-10 text-dark fw-bold ms-2 px-3 py-2 rounded-pill" id="ratingLabel">
                                    @Model.Rating / 5 Stars
                                </span>
                            </div>
                            <span asp-validation-for="Rating" class="text-danger small"></span>
                        </div>

                        <!-- Feedback Comment -->
                        <div class="col-12">
                            <label asp-for="Comment" class="form-label fw-bold">Testimonial &amp; Partnership Feedback</label>
                            <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Describe the business outcomes, delivery speed, and technical excellence achieved with Aveny Technologies..."></textarea>
                            <span asp-validation-for="Comment" class="text-danger small"></span>
                        </div>

                        <!-- Client Avatar Upload -->
                        <div class="col-12">
                            <label asp-for="ImageFile" class="form-label fw-bold">Client / Company Avatar</label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" onchange="previewTestimonialCreateAvatar(this)" />
                            <div class="form-text">Supported formats: JPG, PNG, WEBP, GIF (Max size: 5MB).</div>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>

                            <div id="testimonialCreateAvatarPreviewContainer" class="mt-3 d-none">
                                <p class="small text-muted mb-1 fw-bold">Avatar Preview:</p>
                                <img id="testimonialCreateAvatarPreview" src="#" alt="Preview" class="rounded-circle shadow-sm border" style="width: 70px; height: 70px; object-fit: cover;" />
                            </div>
                        </div>

                        <!-- Active Switch -->
                        <div class="col-12 mt-3">
                            <div class="form-check form-switch fs-6">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="testimonialActiveSwitch" checked />
                                <label class="form-check-label fw-bold ms-2" for="testimonialActiveSwitch">
                                    Publish endorsement on public website
                                </label>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-12 mt-4 pt-3 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                                <i class="fa fa-save me-2"></i>Publish Review
                            </button>
                            <a asp-area="Admin" asp-controller="Testimonials" asp-action="Index" class="btn btn-light rounded-pill px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setRating(value) {
            document.getElementById('ratingInput').value = value;
            document.getElementById('ratingLabel').textContent = value + ' / 5 Stars';

            const stars = document.querySelectorAll('#starPicker .star-rating-btn');
            stars.forEach((star, index) => {
                if (index < value) {
                    star.classList.remove('unselected');
                } else {
                    star.classList.add('unselected');
                }
            });
        }

        function previewTestimonialCreateAvatar(input) {
            const previewContainer = document.getElementById('testimonialCreateAvatarPreviewContainer');
            const previewImg = document.getElementById('testimonialCreateAvatarPreview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewContainer.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
