          <mxGeometry x="640" y="400" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Phase 5: Security & Authentication -->
        <mxCell id="Step5" value="Phase 5: Security &amp; Authentication Engine&#xa;• ASP.NET Core Cookie Authentication &amp; ClaimsPrincipal&#xa;• BCrypt salted password hashing with BCrypt.Net-Next&#xa;• Global Anti-CSRF token validation &amp; ForwardedHeaders for reverse proxies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="120" y="485" width="480" height="70" as="geometry" />
