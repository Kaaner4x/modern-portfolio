        <!-- Phase 1: Solution Setup -->
        <mxCell id="Step1" value="Phase 1: Solution Setup &amp; Architecture&#xa;• .NET 10 (C# 14) ASP.NET Core MVC&#xa;• Clean N-Tier folder &amp; project structure&#xa;• Dependency Injection &amp; IoC configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
