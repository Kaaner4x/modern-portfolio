          <mxGeometry x="640" y="500" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Phase 6: Public Showcase Portal -->
        <mxCell id="Step6" value="Phase 6: Public Showcase UI &amp; Dynamic Razor Templates&#xa;• Bootstrap 5 modern UI with AOS animations &amp; Swiper testimonials carousel&#xa;• Filterable solutions gallery with GLightbox preview modals &amp; case studies&#xa;• Interactive contact lead intake form with feedback alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
