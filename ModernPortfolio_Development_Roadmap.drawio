          <mxGeometry x="640" y="112" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Phase 2: Domain & Database -->
        <mxCell id="Step2" value="Phase 2: Domain Modeling &amp; Database Design&#xa;• PostgreSQL 16 schema &amp; constraints (Users, About, Skills, Projects, Testimonials, Contacts)&#xa;• Dapper Micro-ORM &amp; Npgsql connection pooling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="120" y="195" width="480" height="65" as="geometry" />
