          <mxGeometry x="640" y="302" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Phase 4: Business Logic & Services -->
        <mxCell id="Step4" value="Phase 4: Business Logic &amp; Service Layer&#xa;• Service contracts (IProjectService, ISkillService, IAboutService, etc.)&#xa;• ImageService with MIME whitelist, GUID naming &amp; traversal protection&#xa;• DatabaseInitializerService for auto-table creation &amp; seeding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
