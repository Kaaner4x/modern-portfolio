@model List<ProjectViewModel>

@{
    ViewData["Title"] = "Solutions & Products";
}

<!-- Portfolio / Solutions Section -->
<section id="portfolio" class="portfolio section">

  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <h2>Enterprise Solutions &amp; Innovations</h2>
    <p>Discover our flagship platforms, custom software architectures, and client case studies delivered across global industries.</p>
  </div><!-- End Section Title -->

  <div class="container">

    <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">

      <div class="row gy-4 isotope-container" data-aos="fade-up" data-aos-delay="200">

        @if (Model != null && Model.Any())
        {
          @foreach (var project in Model)
          {
            <div class="col-lg-4 col-md-6 portfolio-item isotope-item">
              <img src="@(string.IsNullOrEmpty(project.ImageUrl) ? "/ui/img/portfolio/portfolio-1.jpg" : project.ImageUrl)" class="img-fluid rounded shadow-sm" alt="@project.Title">
              <div class="portfolio-info">
                <h4>@project.Title</h4>
                <p>@project.Description</p>
                <a href="@(string.IsNullOrEmpty(project.ImageUrl) ? "/ui/img/portfolio/portfolio-1.jpg" : project.ImageUrl)" title="@project.Title" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                <a asp-controller="Project" asp-action="Details" asp-route-id="@project.Id" title="More Details" class="details-link"><i class="bi bi-link-45deg"></i></a>
              </div>
            </div><!-- End Portfolio Item -->
          }
        }
        else
        {
          <div class="col-12 text-center py-5">
            <div class="p-5 bg-light rounded-3">
              <i class="bi bi-laptop fs-1 text-primary mb-3 d-block"></i>
              <h4>Cutting-Edge Engineering Solutions</h4>
              <p class="text-muted">Explore our cloud-native platforms, AI integrations, and high-throughput transaction engines.</p>
            </div>
          </div>
        }

      </div><!-- End Portfolio Container -->

    </div>

  </div>

</section><!-- /Portfolio Section -->