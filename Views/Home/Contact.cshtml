@model ContactViewModel

@{
  ViewData["Title"] = "Contact Us";
}

<!-- Contact Section -->
<section id="contact" class="contact section">

  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <h2>Get in Touch with Aveny Technologies</h2>
    <p>Have an engineering challenge or enterprise initiative? Connect with our solution architects and software engineers today.</p>
  </div><!-- End Section Title -->

  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="row gy-4">

      <div class="col-lg-5">

        <div class="info-wrap">
          <div class="info-item d-flex" data-aos="fade-up" data-aos-delay="200">
            <i class="bi bi-geo-alt flex-shrink-0"></i>
            <div>
              <h3>Global Headquarters</h3>
              <p>500 Howard Street, Suite 400, San Francisco, CA 94105</p>
            </div>
          </div><!-- End Info Item -->

          <div class="info-item d-flex" data-aos="fade-up" data-aos-delay="300">
            <i class="bi bi-telephone flex-shrink-0"></i>
            <div>
              <h3>Direct Hotline</h3>
              <p>+1 (800) 555-AVENY / +1 (800) 555-2836</p>
            </div>
          </div><!-- End Info Item -->

          <div class="info-item d-flex" data-aos="fade-up" data-aos-delay="400">
            <i class="bi bi-envelope flex-shrink-0"></i>
            <div>
              <h3>Enterprise Inquiries</h3>
              <p>contact@avenytechnologies.com</p>
            </div>
          </div><!-- End Info Item -->

          <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3153.0863897129596!2d-122.39958742337775!3d37.78796851121175!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8085807c4b0713b9%3A0x6b44f275681e59!2sHoward%20St%2C%20San%20Francisco%2C%20CA!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus"
          frameborder="0" style="border:0; width: 100%; height: 270px;" allowfullscreen="" loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>

      <div class="col-lg-7">
        <form asp-controller="Home" asp-action="Contact" method="post" class="email-form" data-aos="fade-up" data-aos-delay="200">
          <div class="row gy-4">

            <div class="col-md-6">
              <label asp-for="Name" class="pb-2 fw-semibold">Your Name / Organization</label>
              <input asp-for="Name" class="form-control" placeholder="e.g. John Doe / Acme Corp">
              <span class="text-danger" asp-validation-for="Name"></span>
            </div>

            <div class="col-md-6">
              <label asp-for="Email" class="pb-2 fw-semibold">Work Email Address</label>
              <input asp-for="Email" class="form-control" placeholder="e.g. name@company.com">
              <span class="text-danger" asp-validation-for="Email"></span>
            </div>

            <div class="col-md-12">
              <label asp-for="Subject" class="pb-2 fw-semibold">Inquiry Subject</label>
              <input asp-for="Subject" class="form-control" placeholder="e.g. Enterprise Cloud Architecture Consultation">
              <span class="text-danger" asp-validation-for="Subject"></span>
            </div>

            <div class="col-md-12">
              <label asp-for="Message" class="pb-2 fw-semibold">Project Scope or Message</label>
              <textarea asp-for="Message" class="form-control" rows="8" placeholder="Tell us about your technical requirements, goals, timeline, and tech stack..."></textarea>
              <span class="text-danger" asp-validation-for="Message"></span>
            </div>

            <div class="col-md-12 text-center">
              <div class="loading">Loading</div>
              <div class="error-message"></div>
              @if (@TempData["SuccessMessage"] != null)
              {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
              }

              <button type="submit" class="btn btn-primary rounded-pill px-5 py-2">Submit Inquiry</button>
            </div>

          </div>
        </form>
      </div><!-- End Contact Form -->

    </div>

  </div>

</section><!-- /Contact Section -->

@section Scripts {
  @await Html.PartialAsync("_ValidationScriptsPartial")
}