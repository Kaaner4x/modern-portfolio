@model AboutSkillsViewModel
@{
    ViewData["Title"] = "About";
    int i = 0;
}

<!-- About Section -->
<section id="about" class="about section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>About Me</h2>
        <p>A glimpse into my professional journey, passion for software engineering, and technical background.</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4 justify-content-center">
            <div class="col-lg-4">
                <img src="@(string.IsNullOrEmpty(Model.About?.ImageUrl) ? "/ui/img/profile-img.jpg" : Model.About?.ImageUrl)" class="img-fluid rounded" alt="@(Model.About?.Title ?? "Profile Picture")">
            </div>
            <div class="col-lg-8 content">
                <h2>@(Model.About?.Title ?? "Software Developer & Problem Solver")</h2>
                <p class="fst-italic py-2 mb-3">
                    @(Model.About?.Description ?? "Passionate software engineer focused on designing and building scalable web applications.")
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Age:</strong> <span>@Model.About?.Age</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Email:</strong>
                                <a href="mailto:@Model.About?.Email"><span>@Model.About?.Email</span></a>
                            </li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Location:</strong>
                                <span>@Model.About?.City</span>
                            </li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>GitHub:</strong>
                                <a href="@Model.About?.GithubUrl" target="_blank" rel="noopener noreferrer"><span>@Model.About?.GithubUrl</span></a>
                            </li>
                            <li><i class="bi bi-chevron-right"></i> <strong>LinkedIn:</strong>
                                <a href="@Model.About?.LinkedInUrl" target="_blank" rel="noopener noreferrer"><span>@Model.About?.LinkedInUrl</span></a>
                            </li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Phone:</strong>
                                <a href="tel:@Model.About?.PhoneNumber"><span>@Model.About?.PhoneNumber</span></a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>

</section><!-- /About Section -->

<!-- Skills Section -->
<section id="skills" class="skills section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Skills &amp; Expertise</h2>
        <p>A comprehensive overview of my technical capabilities, programming proficiencies, and modern development toolsets.</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row skills-content skills-animation">
            @{
                int rightCount = Model.GetSkillsCount() / 2;
                int leftCount = Model.GetSkillsCount() - rightCount;
            }
            <div class="col-lg-6">
                @for (i = 0; i < leftCount; i++)
                {
                    <div class="progress">
                        <span class="skill"><span>@Model.Skills[i].Name</span> <i
                                class="val">@Model.Skills[i].Percentage%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="@Model.Skills[i].Percentage"
                                aria-valuemin="0" aria-valuemax="100" style="width: @Model.Skills[i].Percentage%;"></div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-6">
                @for (int j = i; j < Model.Skills.Count; j++)
                {
                    <div class="progress">
                        <span class="skill"><span>@Model.Skills[j].Name</span> <i
                                class="val">@Model.Skills[j].Percentage%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="@Model.Skills[j].Percentage"
                                aria-valuemin="0" aria-valuemax="100" style="width: @Model.Skills[j].Percentage%;"></div>
                        </div>
                    </div>
                }
            </div>

        </div>

    </div>

</section><!-- /Skills Section -->