@model AboutSkillsViewModel
@{
    ViewData["Title"] = "About Us";
    int i = 0;
}

<!-- About Section -->
<section id="about" class="about section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>About Aveny Technologies</h2>
        <p>Architecting robust, cloud-native enterprise platforms and high-velocity digital solutions.</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4 justify-content-center">
            <div class="col-lg-4">
                <img src="@(string.IsNullOrEmpty(Model.About?.ImageUrl) ? "/ui/img/profile-img.jpg" : Model.About?.ImageUrl)" class="img-fluid rounded shadow-sm" alt="Aveny Technologies">
            </div>
            <div class="col-lg-8 content">
                <h2>@(Model.About?.Title ?? "Enterprise Software Engineering & Cloud Solutions")</h2>
                <p class="fst-italic py-2 mb-3">
                    @(Model.About?.Description ?? "Aveny Technologies is an innovative software engineering and technology consulting company. We architect robust cloud-native platforms, high-throughput distributed microservices, and AI-driven digital ecosystems that empower forward-thinking enterprises worldwide.")
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Industry Experience:</strong> <span>@(Model.About?.Age > 0 ? $"{Model.About?.Age}+ Years of Engineering Excellence" : "6+ Years of Industry Leadership")</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Corporate Email:</strong>
                                <a href="mailto:@(Model.About?.Email ?? "contact@avenytechnologies.com")"><span>@(Model.About?.Email ?? "contact@avenytechnologies.com")</span></a>
                            </li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Headquarters:</strong>
                                <span>@(Model.About?.City ?? "San Francisco, CA & Global Hubs")</span>
                            </li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Open Source:</strong>
                                <a href="@(Model.About?.GithubUrl ?? "https://github.com")" target="_blank" rel="noopener noreferrer"><span>@(Model.About?.GithubUrl ?? "https://github.com")</span></a>
                            </li>
                            <li><i class="bi bi-chevron-right"></i> <strong>LinkedIn:</strong>
                                <a href="@(Model.About?.LinkedInUrl ?? "https://linkedin.com")" target="_blank" rel="noopener noreferrer"><span>@(Model.About?.LinkedInUrl ?? "https://linkedin.com")</span></a>
                            </li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Phone / Hotline:</strong>
                                <a href="tel:@(Model.About?.PhoneNumber ?? "+180055528369")"><span>@(Model.About?.PhoneNumber ?? "+1 (800) 555-AVENY")</span></a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>

</section><!-- /About Section -->

<!-- Skills Section -->
<section id="skills" class="skills section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Technology Stack &amp; Core Competencies</h2>
        <p>A comprehensive overview of our engineering proficiencies, cloud architectures, and modern technology toolsets.</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row skills-content skills-animation">
            @{
                int skillCount = Model.GetSkillsCount();
                int rightCount = skillCount / 2;
                int leftCount = skillCount - rightCount;
            }
            <div class="col-lg-6">
                @for (i = 0; i < leftCount; i++)
                {
                    <div class="progress">
                        <span class="skill"><span>@Model.Skills[i].Name</span> <i
                                class="val">@Model.Skills[i].Percentage%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="@Model.Skills[i].Percentage"
                                aria-valuemin="0" aria-valuemax="100" style="width: @Model.Skills[i].Percentage%;"></div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-6">
                @for (int j = i; j < skillCount; j++)
                {
                    <div class="progress">
                        <span class="skill"><span>@Model.Skills[j].Name</span> <i
                                class="val">@Model.Skills[j].Percentage%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="@Model.Skills[j].Percentage"
                                aria-valuemin="0" aria-valuemax="100" style="width: @Model.Skills[j].Percentage%;"></div>
                        </div>
                    </div>
                }
            </div>

        </div>

    </div>

</section><!-- /Skills Section -->