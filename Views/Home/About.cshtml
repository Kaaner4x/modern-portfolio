@model AboutViewModel

@{
    ViewData["Title"] = "About";
}

<!-- About Section -->
<section id="about" class="about section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>About</h2>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4 justify-content-center">
            <div class="col-lg-4">
                <img src="@(Model?.ImageUrl ?? "/images/default.jpg")" class="img-fluid" alt="@Model?.Title">
            </div>
            <div class="col-lg-8 content">
                <h2>@Model?.Title</h2>
                <p class="fst-italic py-3">
                    @Model?.Description
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Age:</strong> <span>@Model?.Age</span></li>
                            <li>
                                <i class="bi bi-chevron-right"></i> <strong>Email:</strong>
                                <a href="mailto:@Model?.Email"><span>@Model?.Email</span></a>
                            </li>
                            <li><i class="bi bi-chevron-right"></i> <strong>City:</strong> <span>@Model?.City</span></li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                            <li>
                                <i class="bi bi-chevron-right"></i> <strong>Github:</strong>
                                <a href="@Model?.GithubUrl" target="_blank" rel="noopener noreferrer"><span>@Model?.GithubUrl</span></a>
                            </li>
                            <li>
                                <i class="bi bi-chevron-right"></i> <strong>LinkedIn:</strong>
                                <a href="@Model?.LinkedInUrl" target="_blank" rel="noopener noreferrer"><span>@Model?.LinkedInUrl</span></a>
                            </li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Phone Number:</strong> <span>@Model?.PhoneNumber</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>

</section><!-- /About Section -->