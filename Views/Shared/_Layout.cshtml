@using ModernPortfolio.Extensions

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>@ViewData["Title"] - Aveny Technologies</title>
  <meta name="description" content="Aveny Technologies is an innovative enterprise software engineering and cloud transformation company specializing in high-performance digital solutions.">
  <meta name="keywords" content="Aveny Technologies, software engineering, cloud solutions, dotnet, microservices, artificial intelligence, enterprise software">
  <meta name="author" content="Aveny Technologies" />

  <!-- Favicons -->
  <link href="~/ui/favicon.png" rel="icon">
  <link href="~/ui/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link
  href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
  rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="~/ui/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/ui/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="~/ui/vendor/aos/aos.css" rel="stylesheet">
  <link href="~/ui/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
  <link href="~/ui/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="~/ui/css/main.css" rel="stylesheet">
</head>

<body class="index-page">

  <header id="header" class="header d-flex align-items-center light-background sticky-top">
    <div class="container-fluid position-relative d-flex align-items-center justify-content-between">

      <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center me-auto me-xl-0 text-decoration-none">
        <h1 class="sitename fw-bold">Aveny<span class="text-primary">.</span></h1>
      </a>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a asp-controller="Home" asp-action="Index" class="@Html.IsActive("Home", "Index")">Home</a></li>
          <li><a asp-controller="Home" asp-action="About" class="@Html.IsActive("Home", "About")">About Us</a></li>
          <li><a asp-controller="Project" asp-action="Index" class="@Html.IsActive("Project", "Index")">Solutions</a></li>
          <li><a asp-controller="Home" asp-action="Contact" class="@Html.IsActive("Home", "Contact")">Contact</a></li>
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>

      <div class="header-social-links">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="github" title="GitHub"><i class="bi bi-github"></i></a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="linkedin" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="twitter" title="X (Twitter)"><i class="bi bi-twitter-x"></i></a>
      </div>

    </div>
  </header>

  <main class="main">

    @RenderBody()

  </main>

  <footer id="footer" class="footer light-background">

    <div class="container">
      <div class="copyright text-center">
        <p>© <span>Copyright</span> <strong class="px-1 sitename">Aveny Technologies</strong> <span>All Rights Reserved</span></p>
      </div>
      <div class="social-links d-flex justify-content-center">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="github" title="GitHub"><i class="bi bi-github"></i></a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="linkedin" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="twitter" title="X (Twitter)"><i class="bi bi-twitter-x"></i></a>
      </div>
      <div class="credits">
        Engineering next-generation digital platforms and cloud solutions.
      </div>
      <div class="text-center mt-3">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-muted small text-decoration-none opacity-75" title="Admin Control Console">
          <i class="bi bi-shield-lock me-1"></i>Admin Portal
        </a>
      </div>
    </div>

  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i
    class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader"></div>

  <!-- Vendor JS Files -->
  <script src="~/ui/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="~/ui/vendor/php-email-form/validate.js"></script>
  <script src="~/ui/vendor/aos/aos.js"></script>
  <script src="~/ui/vendor/waypoints/noframework.waypoints.js"></script>
  <script src="~/ui/vendor/purecounter/purecounter_vanilla.js"></script>
  <script src="~/ui/vendor/swiper/swiper-bundle.min.js"></script>
  <script src="~/ui/vendor/glightbox/js/glightbox.min.js"></script>
  <script src="~/ui/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
  <script src="~/ui/vendor/isotope-layout/isotope.pkgd.min.js"></script>

  <!-- Main JS File -->
  <script src="~/ui/js/main.js"></script>

  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>